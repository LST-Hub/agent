{
  "permissions": {
    "allow": [
      "Bash(docker compose run --rm agent teams-allocations --no-save*)",
      "Bash(docker compose run --rm agent project-health --dry-run*)",
      "Bash(docker compose run --rm agent daily-ops --dry-run*)",
      "Bash(docker compose run --rm agent forecast --dry-run*)",
